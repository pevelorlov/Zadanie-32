DEEPSEEK_API_KEY=вставьте_сюда_свой_ключ
DEEPSEEK_MODEL=deepseek-v4-flash
# Необязательно: DEBUG, INFO, WARNING или ERROR. По умолчанию INFO.
DEEPSEEK_LOG_LEVEL=INFO
# Необязательно: GitHub Actions из чата. Если не задан, используется локальный Git Credential Manager.
# Права: Actions: write; Contents и Pull requests: read для выбранного репозитория.
# GITHUB_REVIEW_TOKEN=
